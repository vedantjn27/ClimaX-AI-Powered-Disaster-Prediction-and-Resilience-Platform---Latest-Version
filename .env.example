# Weather APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
WAQI_API_KEY=your_waqi_api_key_here

# AI / LLM API
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (the defaults are current Groq production models)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# SMTP email notifications (Gmail defaults shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
ALERT_EMAIL_TO=your_notification_email@example.com
